# Token dari dashboard Fonnte (menu Device > klik device kamu)
FONNTE_TOKEN=

# ID Google Sheet (bagian di URL antara /d/ dan /edit)
# contoh: https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
GOOGLE_SHEET_ID=

# Email service account Google Cloud, formatnya: xxx@xxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON service account (field "private_key")
# Salin apa adanya termasuk -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Tambahan untuk Planner, Todo, dan pengingat pagi ---

# Nomor WhatsApp kamu (hanya nomor ini yang boleh memakai bot & menerima pengingat).
# Boleh format 0812... atau 62812...
OWNER_NUMBER=

# Kata sandi acak untuk mengamankan endpoint cron. Isi string panjang acak.
# Vercel otomatis mengirimnya sebagai "Authorization: Bearer <CRON_SECRET>" saat menjalankan cron.
CRON_SECRET=

# (Opsional) batas kuota pesan Fonnte per bulan, default 1000
FONNTE_QUOTA=1000
