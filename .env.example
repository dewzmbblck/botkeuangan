# Token dari dashboard Fonnte (menu Device > klik device kamu)
FONNTE_TOKEN=

# ID Google Sheet (bagian di URL antara /d/ dan /edit)
# contoh: https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
GOOGLE_SHEET_ID=

# Email service account Google Cloud, formatnya: xxx@xxx.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key dari file JSON service account (field "private_key")
# Salin apa adanya termasuk -----BEGIN PRIVATE KEY----- dan -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
